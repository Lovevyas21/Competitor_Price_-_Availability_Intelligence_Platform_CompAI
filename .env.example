# --- Database ---
POSTGRES_USER=cpi
POSTGRES_PASSWORD=cpi_local_dev
POSTGRES_DB=cpi
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Managed Postgres (Neon) ---
# Paste the connection string from the Neon dashboard here. It already contains the
# password, so keep it in .env only -- .env is gitignored and must never be committed.
# Format: postgresql://<user>:<pw>@<host>.neon.tech/<db>?sslmode=require
# Leave this unset to use the local docker-compose Postgres above.
# DATABASE_URL_OVERRIDE=

# --- Redis (Celery broker, phase 2) ---
REDIS_URL=redis://localhost:6379/0

# --- Bronze storage: "local" now, "s3" in phase 6 ---
BRONZE_BACKEND=local
BRONZE_LOCAL_PATH=./data/bronze
DEADLETTER_LOCAL_PATH=./data/deadletter
# BRONZE_S3_BUCKET=cpi-bronze

# --- Source API credentials (all optional; keyless sources need none) ---
# BESTBUY_API_KEY=
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
# DIGIKEY_CLIENT_ID=
# DIGIKEY_CLIENT_SECRET=

LOG_LEVEL=INFO
ENV=dev

# --- Alerting (phase 4) ---
# Undercut alerts post here. Leave unset to record alerts without delivering them.
# SLACK_WEBHOOK_URL=

# --- API (phase 4) ---
# Required header: X-API-Key. Leave unset in dev to disable auth entirely.
# API_KEY=

# --- AI layer (phase 5) ---
# Optional. Unset = the weekly brief renders deterministically from validated facts.
# Set both the model and its provider key to enable CrewAI narration.
# Pin an explicit model rather than a `-latest` alias: an alias changes the model
# underneath you, so the brief's wording can shift with no change on your side.
# Availability varies by model -- under a burst of calls (the crew makes three) some
# return 503 far more often than others, so test before pinning.
# LLM_MODEL=gemini/gemini-3.5-flash
# GEMINI_API_KEY=
# Gemini reads GOOGLE_API_KEY in preference to GEMINI_API_KEY. The app sets both from
# the value above so an unrelated GOOGLE_API_KEY in your shell cannot hijack requests.
#
# --- LLM cost control (defaults suit a free-tier key) ---
# Reasoning off is the single biggest saving. CrewAI turns Gemini's thinking ON by
# default for any 2.5+ model; measured on the real facts payload, one brief cost
# 12,473 tokens over 3 requests before these settings and 2,422 over 1 request after.
# LLM_THINKING=false
# LLM_MAX_OUTPUT_TOKENS=1200
#
# One writer call instead of the three-agent crew. Set false to run the full crew.
# LLM_SINGLE_CALL=true
#
# Skip the model entirely when the facts have not changed. 0 disables caching.
# LLM_CACHE_TTL_SECONDS=86400
#
# Hard ceilings, shared across workers via Redis.
# LLM_REQUESTS_PER_MINUTE=10
# LLM_DAILY_REQUEST_LIMIT=200

# --- Alert delivery (all optional; nothing sends unless configured) ---
# SLACK_WEBHOOK_URL=
# ALERT_EMAIL_TO=pricing@example.com,analyst@example.com
# ALERT_EMAIL_FROM=alerts@example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# On AWS, prefer SES over SMTP -- the instance role supplies credentials:
# SES_REGION=ap-south-1

# --- Showcase walkthrough (/showcase) ---
# A guided, cinematic walk through the pipeline against live mart data. It carries no
# API key check, so it defaults to dev only. Set it true to serve it from a demo
# deployment on purpose; false to keep it off even in dev.
# SHOWCASE_ENABLED=true
